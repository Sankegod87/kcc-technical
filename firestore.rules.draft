// DRAFT - not deployed. The app has no Firebase sign-in yet, so these rules would lock it out today.
// Plan: enable Anonymous sign-in in the Firebase console, call signInAnonymously() at startup,
// then paste these rules into Firestore > Rules. Check the current rules there first: if they
// say "allow read, write: if true" anyone on the internet can read every password hash and edit the rota.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stage-light-tracker/main {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['payload','nonce','updatedAt'])
                   && request.resource.data.payload is string
                   && request.resource.data.payload.size() < 900000;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
